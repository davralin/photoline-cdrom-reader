{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "schedule": ["before 5am on the first day of the month"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Group all monthly dependency updates into one CI-gated PR",
      "matchPackageNames": ["*"],
      "groupName": "monthly dependency updates",
      "groupSlug": "monthly-dependency-updates",
      "automerge": true
    }
  ]
}
